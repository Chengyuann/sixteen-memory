# No credential belongs in Git. Configure these on the deployment host.
MEMORY_API_KEY=
DATABASE_PATH=/data/memory.sqlite3
MEMORY_MODE=hybrid
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
ENABLE_FACTS=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
CHUNK_CHARS=1200
MAX_CHUNKS_PER_USER=10000
MAX_CONCURRENT_REQUESTS=2
RETENTION_DAYS=30
# Supply the exact Git commit at deployment; do not claim an unfrozen version.
SOURCE_COMMIT=unreleased
