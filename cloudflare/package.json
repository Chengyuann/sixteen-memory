{
  "name": "sixteen-memory-cloudflare",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:runtime": "tsx scripts/runtime-smoke.ts",
    "test:extended": "node scripts/extended-runtime.mjs",
    "test:pages-entry": "node scripts/pages-entry-runtime.mjs",
    "test:deep": "wrangler deploy test/alarm-harness.ts --dry-run --outdir dist-test && node scripts/deep-runtime.mjs",
    "test:long-query": "node scripts/long-query-runtime.mjs",
    "test:retrieval": "node scripts/retrieval-quality.mjs",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "miniflare": "5.20261023.2-beta",
    "tsx": "^4",
    "typescript": "^5.9",
    "wrangler": "4.155.0"
  }
}
